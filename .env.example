WHATSAPP_GROUP_NAME=TenBit_Daily_Task_Reporting
WHATSAPP_URL=https://web.whatsapp.com
WHATSAPP_PROFILE_PATH=~/.config/whatsapp_wa_bot_profile

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to: nvidia | mistral | openai | ollama (planned)
LLM_PROVIDER=nvidia

# NVIDIA NIM (Recommended — Production)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=mistralai/mistral-large-2-instruct

# Mistral (Fallback)
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-small-latest

# OpenAI (Optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama (Local, Offline — planned)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# ── Custom Prompt Override ────────────────────────────────────────────────────
# Leave blank to use default prompt. Set to override system prompt for LLM.
CUSTOM_SYSTEM_PROMPT=

# ── Pipeline ──────────────────────────────────────────────────────────────────
TARGET_WINDOW_DAYS=7
DRY_RUN=false
EXCEL_OUTPUT_PATH=./data/tasks.xlsx
DB_PATH=./data/tasks.db
LOG_LEVEL=INFO
MAX_MESSAGES_PER_RUN=200
MAX_GROUP_SEARCH_WAIT_SECONDS=60

# ── Sender name mapping ───────────────────────────────────────────────────────
# Format: 923044233803=Chaudhry Safian,923234770731=Muhammad Uzair
# Short codes also work: AT=Ayan,AR=Abdul Rehman,OP=Farah
SENDER_NAME_MAP=
